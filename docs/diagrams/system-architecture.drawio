<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="architecture" name="System Architecture"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="users" value="&lt;b style=&quot;font-size:16px&quot;&gt;Authorized Users&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Parent • Clinic Secretary • Pediatrician (Doctor / Clinic Admin)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;fontColor=#FFFFFF;strokeColor=none;arcSize=14;spacing=12;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="40" width="560" height="70" as="geometry"/></mxCell><mxCell id="presentation" value="&lt;b style=&quot;font-size:16px&quot;&gt;Presentation Layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;React 19 • Vite 8 • React Router 7 • Tailwind CSS 4 • Recharts • Lucide Icons&lt;br&gt;html5-qrcode / qrcode • Driver.js • Capacitor 8 (Android) • PWA Service Worker&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;fontColor=#FFFFFF;strokeColor=none;arcSize=14;spacing=12;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="150" width="560" height="90" as="geometry"/></mxCell><mxCell id="application" value="&lt;b style=&quot;font-size:20px&quot;&gt;Application Layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Firebase Hosting + Cloud Functions&lt;br&gt;Node.js 22 / Express 5 API&lt;br&gt;Queue engine, reservations, and service communication&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;fontColor=#FFFFFF;strokeColor=none;arcSize=14;spacing=12;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="280" width="660" height="120" as="geometry"/></mxCell><mxCell id="database" value="&lt;b style=&quot;font-size:16px&quot;&gt;Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Firebase Realtime Database&lt;br&gt;Users • Reservations • Live Queue&lt;br&gt;Schedules • Notifications • Audit Logs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;fontColor=#FFFFFF;strokeColor=none;arcSize=14;spacing=12;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="460" width="310" height="100" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b style=&quot;font-size:16px&quot;&gt;Authentication&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Firebase Authentication&lt;br&gt;User accounts and role-based access&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;fontColor=#FFFFFF;strokeColor=none;arcSize=14;spacing=12;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="460" width="310" height="100" as="geometry"/></mxCell><mxCell id="external" value="&lt;b style=&quot;font-size:16px&quot;&gt;External Services&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Textbee.dev SMS Gateway API v1 — OTP Verification • Queue SMS Alerts&lt;br&gt;Web Push Protocol (VAPID) — web-push 3.6 — Real-time Queue Notifications&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;fontColor=#FFFFFF;strokeColor=none;arcSize=14;spacing=12;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="620" width="660" height="100" as="geometry"/></mxCell><mxCell id="process" value="&lt;b style=&quot;font-size:16px&quot;&gt;RESERVATION &amp;amp; QUEUE PROCESS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Parent Selects Clinic Day → claimReservationSlot Cloud Function → Reservation + Queue Number Saved to Realtime Database → Secretary QR Check-in → Queue Recalculated → Sent to Doctor → Consultation Completed → Slot Released&lt;/span&gt;" style="rounded=1