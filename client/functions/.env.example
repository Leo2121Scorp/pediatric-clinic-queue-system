# Loaded automatically when you deploy Cloud Functions.
# Required on production (pediatric-clinic-queue-system). Staging may omit (defaults to testing RTDB).
RTDB_URL=https://pediatric-clinic-queue-testing-default-rtdb.asia-southeast1.firebasedatabase.app

# Second Realtime Database. Create it in the console as {projectId}-demo before deploying demo triggers.
DEMO_RTDB_INSTANCE=pediatric-clinic-queue-testing-demo
DEMO_RTDB_URL=https://pediatric-clinic-queue-testing-demo.asia-southeast1.firebasedatabase.app

# Generate with: cd ../server && npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@pediatric-clinic-queue-testing.web.app

# textbee.dev SMS gateway
TEXTBEE_API_KEY=
# TEXTBEE_DEVICE_ID=
