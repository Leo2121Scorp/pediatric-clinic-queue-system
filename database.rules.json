{
  "rules": {
    "users": {
      ".read": "auth.token.isDemo != true && (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor'))",
      ".indexOn": [
        "phone",
        "phoneNumber",
        "email"
      ],
      "$uid": {
        ".read": "auth.token.isDemo != true && (auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary'))",
        ".write": "auth.token.isDemo != true && (auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor') && (root.child('users').child(auth.uid).child('status').val() === 'active' || (!root.child('users').child(auth.uid).child('status').exists() && newData.child('status').val() === 'active') || (auth.uid === $uid && root.child('users').child($uid).child('role').val() === 'parent' && root.child('users').child($uid).child('status').val() === 'inactive' && root.child('users').child($uid).child('isDeleted').val() !== true && newData.child('status').val() === 'active' && newData.child('isDeleted').val() !== true)))",
        "role": {
          ".validate": "newData.isString() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && auth.uid === $uid && newData.val() === 'parent') || ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor') && newData.val() === 'secretary'))"
        },
        "status": {
          ".validate": "!data.exists() || newData.val() === data.val() || auth.uid !== $uid || root.child('users').child($uid).child('role').val() !== 'doctor' || newData.val() === 'active'"
        },
        "assignedBranchId": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor'"
        },
        "assignedBranch": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor'"
        },
        "name": {
          ".validate": "auth.uid === $uid || !data.exists() || newData.val() === data.val() || root.child('users').child($uid).child('role').val() !== 'parent'"
        },
        "phone": {
          ".validate": "auth.uid === $uid || !data.exists() || newData.val() === data.val() || root.child('users').child($uid).child('role').val() !== 'parent'"
        },
        "email": {
          ".validate": "auth.uid === $uid || !data.exists() || newData.val() === data.val() || root.child('users').child($uid).child('role').val() !== 'parent'"
        },
        "mustChangePassword": {
          ".validate": "auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor'"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth.token.isDemo != true && (auth != null && auth.uid === $uid)",
        ".write": "auth.token.isDemo != true && (auth != null && root.child('users').child(auth.uid).child('status').val() === 'active' && (auth.uid === $uid || ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor') && (!root.child('users').child($uid).exists() || root.child('users').child($uid).child('role').val() !== 'parent'))))"
      }
    },
    "smsOtps": {
      ".read": false,
      ".write": false
    },
    "phoneVerifications": {
      ".read": false,
      ".write": false
    },
    "passwordResetLimits": {
      ".read": false,
      ".write": false
    },
    "branchConfigurations": {
      ".read": "auth.token.isDemo != true && (auth != null)",
      ".write": "auth.token.isDemo != true && (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor') && root.child('users').child(auth.uid).child('status').val() === 'active')"
    },
    "schedules": {
      ".read": "auth.token.isDemo != true && (auth != null)",
      ".indexOn": [
        "status"
      ],
      "$scheduleId": {
        ".write": "auth.token.isDemo != true && (auth != null && root.child('users').child(auth.uid).child('status').val() === 'active' && (root.child('users').child(auth.uid).child('role').val() === 'doctor' || (root.child('users').child(auth.uid).child('role').val() === 'secretary' && ((newData.exists() && (newData.child('branchId').val() === root.child('users').child(auth.uid).child('assignedBranchId').val() || newData.child('branch').val() === root.child('users').child(auth.uid).child('assignedBranch').val())) || (!newData.exists() && (data.child('branchId').val() === root.child('users').child(auth.uid).child('assignedBranchId').val() || data.child('branch').val() === root.child('users').child(auth.uid).child('assignedBranch').val()))))) && (!newData.exists() || (newData.child('booking').child('activeSlotCount').val() == data.child('booking').child('activeSlotCount').val() && newData.child('booking').child('nextQueueNumber').val() == data.child('booking').child('nextQueueNumber').val())))"
      }
    },
    "clinicClosures": {
      ".read": "auth.token.isDemo != true && (auth != null)",
      "$closureId": {
        ".write": "auth.token.isDemo != true && (auth != null && root.child('users').child(auth.uid).child('status').val() === 'active' && (root.child('users').child(auth.uid).child('role').val() === 'doctor' || (root.child('users').child(auth.uid).child('role').val() === 'secretary' && ((newData.exists() && root.child('users').child(auth.uid).child('assignedBranchId').val() === newData.child('branchId').val()) || (!newData.exists() && root.child('users').child(auth.uid).child('assignedBranchId').val() === data.child('branchId').val())))))"
      }
    },
    "bookingLocks": {
      "$uid": {
        ".read": "auth.token.isDemo != true && (auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
        ".write": false
      }
    },
    "parentBookingCaps": {
      "$uid": {
        ".read": "auth.token.isDemo != true && (auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary' || root.child('users').child(auth.uid).child('role').val() === 'admin'))",
        ".write": false
      }
    },
    "reservations": {
      ".read": "auth.token.isDemo != true && (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (query.orderByChild == 'parentId' && query.equalTo == auth.uid) || query.orderByChild == 'scheduleId'))",
      ".indexOn": [
        "scheduleId",
        "parentId",
        "reservationCode",
        "penaltyTimerExpiresAt"
      ],
      "$reservationId": {
        ".read": "auth.token.isDemo != true && (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary' || root.child('users').child(auth.uid).child('role').val() === 'admin' || data.child('parentId').val() === auth.uid))",
        ".write": "auth.token.isDemo != true && (auth != null && data.exists() && root.child('users').child(auth.uid).child('status').val() === 'active' && (root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary' || (root.child('users').child(auth.uid).child('role').val() === 'parent' && data.child('parentId').val() === auth.uid)))"
      }
    },
    "auditLogs": {
      ".read": "auth.token.isDemo != true && (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor'))",
      ".write": "auth.token.isDemo != true && (auth != null && root.child('users').child(auth.uid).child('status').val() === 'active' && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor'))",
      ".indexOn": [
        "timestamp",
        "category",
        "actorRole"
      ]
    },
    "doctorAlerts": {
      "$uid": {
        ".read": "auth.token.isDemo != true && (auth != null && auth.uid === $uid)",
        ".write": "auth.token.isDemo != true && (auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('status').val() === 'active')"
      }
    },
    "systemConfiguration": {
      "queue": {
        ".read": "auth.token.isDemo != true && (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary'))",
        ".write": false
      },
      "sms": {
        ".read": "auth.token.isDemo != true && (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'secretary' || root.child('users').child(auth.uid).child('role').val() === 'parent'))",
        ".write": false
      },
      "$branchId": {
        ".read": "auth.token.isDemo != true && (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'parent' || (root.child('users').child(auth.uid).child('role').val() === 'secretary' && root.child('users').child(auth.uid).child('assignedBranchId').val() === $branchId)))",
        ".write": "auth.token.isDemo != true && (auth != null && root.child('users').child(auth.uid).child('status').val() === 'active' && root.child('branchConfigurations').child($branchId).exists() && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || (root.child('users').child(auth.uid).child('role').val() === 'secretary' && root.child('users').child(auth.uid).child('assignedBranchId').val() === $branchId)))",
        "sms": {
          ".read": "auth.token.isDemo != true && (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'doctor' || root.child('users').child(auth.uid).child('role').val() === 'parent' || (root.child('users').child(auth.uid).child('role').val() === 'secretary' && root.child('users').child(auth.uid).child('assignedBranchId').val() === $branchId)))"
        }
      }
    }
  }
}
